        <mxCell id="P0BbM0xOkUoMlJnSy2qD-160" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=16;" value="&lt;p dir=&quot;auto&quot;&gt;НАЧАЛО&lt;/p&gt;&lt;p dir=&quot;auto&quot;&gt;Ввод N&lt;br&gt;S := 0&lt;br&gt;i := 1&lt;/p&gt;&lt;div class=&quot;snippet-clipboard-content notranslate position-relative overflow-auto&quot;&gt;&lt;pre class=&quot;notranslate&quot;&gt;&lt;code&gt;ПОКА i &amp;lt;= N&lt;br&gt;    Ввод x&lt;br&gt;    S := S + x&lt;br&gt;    i := i + 1&lt;br&gt;КОНЕЦ ПОКА&lt;br&gt;&lt;br&gt;Вывод S&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;КОНЕЦ" vertex="1">
          <mxGeometry height="274" width="160" x="300" y="110" as="geometry" />
        </mxCell>
        <mxCell id="P0BbM0xOkUoMlJnSy2qD-161" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=16;" value="&lt;p dir=&quot;auto&quot;&gt;НАЧАЛО&lt;br&gt;Ввод a, b, h&lt;br&gt;x := a&lt;/p&gt;&lt;div class=&quot;snippet-clipboard-content notranslate position-relative overflow-auto&quot;&gt;&lt;pre class=&quot;notranslate&quot;&gt;&lt;code&gt;ПОКА x &amp;lt;= b&lt;br&gt;    ЕСЛИ x &amp;gt;= 6 ТО&lt;br&gt;        y := -2 * sin(x) + 4&lt;br&gt;    ИНАЧЕ&lt;br&gt;        y := 3 * cos(x) - 2&lt;br&gt;    КОНЕЦ ЕСЛИ&lt;br&gt;&lt;br&gt;    Вывод x, y&lt;br&gt;    x := x + h&lt;br&gt;КОНЕЦ ПОКА&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p dir=&quot;auto&quot;&gt;КОНЕЦ&lt;/p&gt;&lt;br&gt;&lt;p dir=&quot;auto&quot;&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="280" width="240" x="900" y="90" as="geometry" />
        </mxCell>
        <mxCell id="P0BbM0xOkUoMlJnSy2qD-162" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=16;" value="&lt;p dir=&quot;auto&quot;&gt;НАЧАЛО&lt;br&gt;Ввод a, b&lt;/p&gt;&lt;div class=&quot;snippet-clipboard-content notranslate position-relative overflow-auto&quot;&gt;&lt;pre class=&quot;notranslate&quot;&gt;&lt;code&gt;ПОКА a &amp;lt;&amp;gt; b&lt;br&gt;    ЕСЛИ a &amp;gt; b ТО&lt;br&gt;        a := a - b&lt;br&gt;    ИНАЧЕ&lt;br&gt;        b := b - a&lt;br&gt;    КОНЕЦ ЕСЛИ&lt;br&gt;КОНЕЦ ПОКА&lt;br&gt;&lt;br&gt;Вывод a&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p dir=&quot;auto&quot;&gt;КОНЕЦ&lt;/p&gt;" vertex="1">
          <mxGeometry height="240" width="160" x="1530" y="60" as="geometry" />
        </mxCell>
        <mxCell id="P0BbM0xOkUoMlJnSy2qD-163" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=16;" value="&lt;p dir=&quot;auto&quot;&gt;НАЧАЛО&lt;br&gt;Ввод n&lt;/p&gt;&lt;div class=&quot;snippet-clipboard-content notranslate position-relative overflow-auto&quot;&gt;&lt;pre class=&quot;notranslate&quot;&gt;&lt;code&gt;e := 2&lt;br&gt;fact := 1&lt;br&gt;i := 2&lt;br&gt;&lt;br&gt;ПОКА i &amp;lt;= n&lt;br&gt;    fact := fact * i&lt;br&gt;    e := e + 1 / fact&lt;br&gt;    i := i + 1&lt;br&gt;КОНЕЦ ПОКА&lt;br&gt;&lt;br&gt;Вывод e&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;КОНЕЦ" vertex="1">
          <mxGeometry height="300" width="190" x="2280" y="90" as="geometry" />
        </mxCell>
        <mxCell id="P0BbM0xOkUoMlJnSy2qD-164" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=16;" value="&lt;p dir=&quot;auto&quot;&gt;НАЧАЛО&lt;br&gt;Ввод a, b&lt;/p&gt;&lt;div class=&quot;snippet-clipboard-content notranslate position-relative overflow-auto&quot;&gt;&lt;pre class=&quot;notranslate&quot;&gt;&lt;code&gt;Ввод x&lt;br&gt;&lt;br&gt;ПОКА x &amp;lt; a ИЛИ x &amp;gt; b&lt;br&gt;    Вывод &quot;Повторите ввод&quot;&lt;br&gt;    Ввод x&lt;br&gt;КОНЕЦ ПОКА&lt;br&gt;&lt;br&gt;Вывод x&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;КОНЕЦ" vertex="1">
          <mxGeometry height="260" width="220" x="2895" y="110" as="geometry" />
        </mxCell>
        <mxCell id="P0BbM0xOkUoMlJnSy2qD-165" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=16;" value="&lt;p dir=&quot;auto&quot;&gt;&lt;font&gt;НАЧАЛО&lt;br&gt;Ввод eps&lt;/font&gt;&lt;/p&gt;&lt;div class=&quot;snippet-clipboard-content notranslate position-relative overflow-auto&quot;&gt;&lt;pre class=&quot;notranslate&quot;&gt;&lt;font&gt;&lt;code&gt;S := 1&lt;br&gt;term := 1&lt;br&gt;k := 1&lt;br&gt;&lt;br&gt;ПОКА |term| &amp;gt;= eps&lt;br&gt;    term := -term / 2&lt;br&gt;    S := S + term&lt;br&gt;    k := k + 1&lt;br&gt;КОНЕЦ ПОКА&lt;br&gt;&lt;br&gt;Вывод S&lt;br&gt;&lt;/code&gt;&lt;/font&gt;&lt;/pre&gt;&lt;div class=&quot;zeroclipboard-container&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;    &lt;/div&gt;&lt;/div&gt;&lt;font&gt;КОНЕЦ&lt;/font&gt;" vertex="1">
          <mxGeometry height="320" width="278" x="3460" y="80" as="geometry" />
        </mxCell>
